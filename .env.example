# Copy to .env and set your own values
SEARXNG_URL=http://localhost:8888
MCP_PORT=9555
# FastMCP Host-header allowlist (JSON list); set this to your public MCP host.
# FASTMCP_HTTP_ALLOWED_HOSTS='["mcp.example.com"]'
# Search result fields to return per result object.
# Default trims payload for LLM-friendly responses.
# Leave empty or unset to return all SearXNG fields (backward-compatible).
SEARCH_RESULT_FIELDS=title,url,content,publishedDate
# Root log level for MCP server: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# SEARXNG_USERNAME=
# SEARXNG_PASSWORD=
