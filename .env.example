# Copy to .env and set your own values
# Search providers: each one is active only when configured; search needs at least one.
# SearXNG: set SEARXNG_URL (http(s) URL); basic auth credentials are optional (both or neither).
# SEARXNG_URL=http://localhost:8888
# SEARXNG_USERNAME=
# SEARXNG_PASSWORD=
# You.com: set YDC_API_KEY to enable it. You.com queries go to You.com (US).
# YDC_API_KEY=
MCP_PORT=9555
# FastMCP Host-header allowlist (JSON list); set this to your public MCP host.
# FASTMCP_HTTP_ALLOWED_HOSTS='["mcp.example.com"]'
# Search result fields to return per result object.
# Default trims payload for LLM-friendly responses.
# Leave empty or unset to return all normalized fields.
SEARCH_RESULT_FIELDS=title,url,content,publishedDate,providers
# Root log level for MCP server: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Download Playwright's Chromium automatically on first use if missing (default: true)
# PLAYWRIGHT_AUTO_INSTALL=false
